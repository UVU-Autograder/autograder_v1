{
  "name": "autograder-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup:backend": "node -e \"const {execSync}=require('child_process');const isWin=process.platform==='win32';const pip=isWin?'venv\\\\Scripts\\\\pip':'venv/bin/pip';const pyCmd=isWin?'python':'python3';execSync(pyCmd+' -m venv venv',{cwd:'backend',stdio:'inherit'});execSync(pip+' install -r requirements.txt',{cwd:'backend',stdio:'inherit'});\"",
    "predev:backend": "node -e \"const fs=require('fs');const p=process.platform==='win32'?'backend/venv/Scripts/python.exe':'backend/venv/bin/python';if(!fs.existsSync(p)){console.error('\\nBackend venv not found. Run: npm run setup:backend\\n');process.exit(1)}\"",
    "install:frontend": "cd frontend && npm install",
    "dev:backend": "node -e \"const {spawn}=require('child_process');const isWin=process.platform==='win32';const py=isWin?'venv\\\\Scripts\\\\python':'venv/bin/python';const p=spawn(py,['-m','uvicorn','app.main:app','--host','127.0.0.1','--port','8000','--reload','--reload-dir','app'],{cwd:'backend',stdio:'inherit'});p.on('exit',code=>process.exit(code||0));\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "check": "node -e \"const isWin=process.platform==='win32';const cmd=isWin?'powershell -ExecutionPolicy Bypass -File .\\\\scripts\\\\run_checks.ps1':'bash scripts/run_checks.sh';require('child_process').execSync(cmd,{stdio:'inherit'});\"",
    "openapi:generate": "cd backend && python scripts/generate_openapi.py",
    "docker:build": "docker compose --env-file .env.local build judge0",
    "docker:up": "docker compose --env-file .env.local up -d --build",
    "docker:up:kata": "docker compose --env-file .env.local -f docker-compose.yml -f docker-compose.kata.yml up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:clean": "docker compose down -v"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
