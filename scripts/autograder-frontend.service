# Template for /etc/systemd/system/autograder-frontend.service
#
# Production Next.js server for UVU Autograder listening on 127.0.0.1:3000.
# Nginx (scripts/nginx/autograder-http.conf) proxies port 80/443 traffic to this service.
#
# Installation:
#   1. Adjust User and WorkingDirectory if your repo path differs
#   2. sudo cp scripts/autograder-frontend.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now autograder-frontend.service

[Unit]
Description=UVU Autograder Next.js Frontend Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jaxon
WorkingDirectory=/home/jaxon/autograder_v1/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/npm run start -- -p 3000 -H 127.0.0.1
Restart=always
RestartSec=5
KillMode=process

[Install]
WantedBy=multi-user.target
