# Local Ubuntu proof-of-concept defaults. Copy to .env.local or export these values before compose.
POSTGRES_DB=autograder
POSTGRES_USER=autograder
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://autograder:change-me-local-only@postgres:5432/autograder
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
JUDGE0_URL=http://judge0:2358
JUDGE0_AUTH_TOKEN=change-me-judge0-token
JUDGE0_LANGUAGE_ID=71
JUDGE0_MAX_CONCURRENT=2
SANDBOX_USE_CELERY=true
SANDBOX_UPLOAD_LIMIT=5
SANDBOX_UPLOAD_WINDOW_SECONDS=3600
MAX_UPLOAD_BYTES=52428800
DEFAULT_MAX_FILES=100
DEFAULT_MAX_ZIP_SIZE=52428800
TEST_EXECUTION_TIMEOUT_SECONDS=10
ARTIFACT_STORAGE_DIR=/data/artifacts
RUN_ALEMBIC_MIGRATIONS=true
SEED_DATABASE=true
ENABLE_MOCK_LOGIN=true
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
