# Workstation deployment configuration. Copy to .env.local (gitignored) and configure secrets before compose.
POSTGRES_DB=autograder
POSTGRES_USER=autograder
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://autograder:change-me-local-only@postgres:5432/autograder
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
JUDGE0_URL=http://judge0:2358
JUDGE0_AUTH_TOKEN=change-me-judge0-token
JUDGE0_LANGUAGE_ID=711
# Use 1 on ~8GB laptops; default 2 is sized for the Dell workstation.
JUDGE0_MAX_CONCURRENT=2
SANDBOX_USE_CELERY=true
SANDBOX_UPLOAD_LIMIT=20
SANDBOX_UPLOAD_WINDOW_SECONDS=3600
# Optional (defaults shown). Runs per client address per window; 0 = off. Check the VPN/NAT
# addresses in the nginx log first: a whole class can share one. See backend/app/domains/sandbox/ip_limit.py.
# SANDBOX_IP_HOURLY_LIMIT=0
# SANDBOX_IP_ALLOWLIST=
# Show students "About N submissions ahead of yours" (an anonymous count).
# SANDBOX_SHOW_QUEUE_AHEAD=true
# AI feedback lane: requests answered at once, how many may wait, and for how long (seconds).
# AI_MAX_CONCURRENT=16
# AI_MAX_WAITING=24
# AI_MAX_WAIT_SECONDS=20
MAX_UPLOAD_BYTES=52428800
OFFICIAL_BATCH_LIMIT=200
OFFICIAL_UNFINISHED_LIMIT=1000
DEFAULT_MAX_FILES=100
DEFAULT_MAX_ZIP_SIZE=52428800
TEST_EXECUTION_TIMEOUT_SECONDS=30
ARTIFACT_STORAGE_DIR=/data/artifacts
RUN_ALEMBIC_MIGRATIONS=true
SEED_DATABASE=true
ENABLE_MOCK_LOGIN=true

# Authentication & Environment Controls
# For production pilot: set AUTH_PROVIDER=microsoft, ENVIRONMENT=production, and provide Azure AD credentials.
# For local development: set AUTH_PROVIDER=mock, ENVIRONMENT=development.
AUTH_PROVIDER=mock
ENVIRONMENT=development
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_SECRET=
NEXT_PUBLIC_AUTH_PROVIDER=mock

# Service Network Hardening (bind internal services to 127.0.0.1 so only Nginx reverse proxy is exposed)
POSTGRES_BIND_IP=127.0.0.1
REDIS_BIND_IP=127.0.0.1
JUDGE0_BIND_IP=127.0.0.1
# Kata Bridge Bindings (internal Docker bridge IP for Kata microVM communication with Postgres and Redis)
KATA_POSTGRES_BIND_IP=172.17.0.1
KATA_REDIS_BIND_IP=172.17.0.1

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
# Local LLM Feedback Service (vllm-cs1410.service on port 8001: Gemma 4 12B QAT + cs1410-p3b adapter)
LOCAL_LLM_API_KEY=none
LOCAL_LLM_ENDPOINT=http://127.0.0.1:8001/v1
LOCAL_LLM_MODEL=cs1410-p3b
# Rollback: LOCAL_LLM_MODEL=gemma4-12b-qat
# Prompt each served model was trained on; unlisted models (p3b, the base model) use v8.
# LOCAL_LLM_PROMPT_VERSIONS=cs1410-p4=v9
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://autograder-frontend-mockup.vercel.app
