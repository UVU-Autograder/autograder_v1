{
  "$defs": {
    "ArtifactConfig": {
      "properties": {
        "type": {
          "enum": [
            "pytest_file",
            "model_solution",
            "support_file"
          ],
          "title": "Type",
          "type": "string"
        },
        "display_filename": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Filename"
        }
      },
      "required": [
        "type"
      ],
      "title": "ArtifactConfig",
      "type": "object"
    },
    "BundleConfig": {
      "properties": {
        "entrypoint": {
          "minLength": 1,
          "title": "Entrypoint",
          "type": "string"
        },
        "file_requirements": {
          "items": {
            "$ref": "#/$defs/FileRequirementConfig"
          },
          "title": "File Requirements",
          "type": "array"
        }
      },
      "required": [
        "entrypoint"
      ],
      "title": "BundleConfig",
      "type": "object"
    },
    "CompletionRequirementConfig": {
      "properties": {
        "key": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "test_keys": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Test Keys",
          "type": "array"
        },
        "minimum_passed": {
          "minimum": 1,
          "title": "Minimum Passed",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "label",
        "test_keys",
        "minimum_passed"
      ],
      "title": "CompletionRequirementConfig",
      "type": "object"
    },
    "ConceptsConfig": {
      "properties": {
        "allowlist": {
          "items": {
            "type": "string"
          },
          "title": "Allowlist",
          "type": "array"
        },
        "denylist": {
          "items": {
            "type": "string"
          },
          "title": "Denylist",
          "type": "array"
        }
      },
      "title": "ConceptsConfig",
      "type": "object"
    },
    "FileRequirementConfig": {
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "paths": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paths"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        }
      },
      "required": [
        "label"
      ],
      "title": "FileRequirementConfig",
      "type": "object"
    },
    "RubricGroupConfig": {
      "properties": {
        "key": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label"
      ],
      "title": "RubricGroupConfig",
      "type": "object"
    },
    "ScoringItemConfig": {
      "properties": {
        "key": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "points": {
          "minimum": 0,
          "title": "Points",
          "type": "integer"
        },
        "extra_credit": {
          "title": "Extra Credit",
          "type": "boolean"
        },
        "item_type": {
          "default": "pytest",
          "enum": [
            "pytest",
            "manual"
          ],
          "title": "Item Type",
          "type": "string"
        },
        "rubric_group_key": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric Group Key"
        },
        "inputs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs"
        },
        "outputs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outputs"
        }
      },
      "required": [
        "key",
        "label",
        "points",
        "extra_credit"
      ],
      "title": "ScoringItemConfig",
      "type": "object"
    }
  },
  "properties": {
    "bundle": {
      "$ref": "#/$defs/BundleConfig"
    },
    "artifacts": {
      "additionalProperties": {
        "$ref": "#/$defs/ArtifactConfig"
      },
      "minProperties": 1,
      "title": "Artifacts",
      "type": "object"
    },
    "scoring_items": {
      "items": {
        "$ref": "#/$defs/ScoringItemConfig"
      },
      "minItems": 1,
      "title": "Scoring Items",
      "type": "array"
    },
    "concepts": {
      "$ref": "#/$defs/ConceptsConfig"
    },
    "completion_requirements": {
      "items": {
        "$ref": "#/$defs/CompletionRequirementConfig"
      },
      "title": "Completion Requirements",
      "type": "array"
    },
    "dependencies": {
      "items": {
        "type": "string"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "rubric_groups": {
      "items": {
        "$ref": "#/$defs/RubricGroupConfig"
      },
      "title": "Rubric Groups",
      "type": "array"
    }
  },
  "required": [
    "bundle",
    "artifacts",
    "scoring_items"
  ],
  "title": "AssignmentConfigV1",
  "type": "object"
}